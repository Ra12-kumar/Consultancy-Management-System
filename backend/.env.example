# The backend reads the ROOT .env (../.env), so the frontend and backend share one settings file.
# Values set in the real environment (e.g. by a hosting platform) always win.
# The backend-only settings are listed here for reference. Placeholders only.
NODE_ENV=development
BACKEND_PORT=5100
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/education_consultancy
SESSION_SECRET=replace_with_a_secure_random_secret
LOG_LEVEL=info
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

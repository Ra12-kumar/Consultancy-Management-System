{
  "name": "education-consultancy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:watch": "vitest",
    "seed": "tsx ../database/seeds/seed-catalog.ts",
    "db:check": "tsx ../database/scripts/check-connection.ts",
    "admin:bootstrap": "tsx ../database/scripts/bootstrap-admin.ts",
    "invite:create": "tsx ../database/scripts/create-invite.ts",
    "seed:catalog": "tsx ../database/seeds/seed-catalog.ts",
    "seed:remove-samples": "tsx ../database/scripts/remove-samples.ts",
    "catalog:rebuild": "tsx ../database/scripts/rebuild-catalog.ts",
    "migrate:stage2": "tsx ../database/scripts/migrate-stage2.ts",
    "migrate:stage3": "tsx ../database/scripts/migrate-stage3.ts",
    "migrate:stage5": "tsx ../database/scripts/migrate-stage5.ts",
    "migrate:stage7": "tsx ../database/scripts/migrate-stage7.ts",
    "migrate:directory": "tsx ../database/scripts/migrate-directory.ts",
    "migrate:indexes": "tsx ../database/scripts/migrate-indexes.ts",
    "websites:check": "tsx ../database/scripts/check-college-websites.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "swagger-ui-dist": "^5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}

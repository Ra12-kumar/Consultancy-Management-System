# Education Consultancy Management System: copy to .env and fill in. Placeholders only; never put real
# secrets in this file. The backend validates these at startup (backend/src/config/env.ts).

NODE_ENV=development
APP_NAME=EduPath Consultancy
FRONTEND_PORT=3000
BACKEND_PORT=5100
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5100/api
# Browser origins allowed to call the API (comma separated). Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000

# This project's own database (never the Gym application's).
MONGODB_URI=mongodb://127.0.0.1:27017/education_consultancy

# Sessions (HttpOnly cookie). The secret must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_secure_random_secret
SESSION_TTL_DAYS=7
SESSION_MAX_DAYS=30

LOG_LEVEL=info

# Email through Brevo's SMTP relay (Brevo > Settings > SMTP & API > SMTP). Without all five values, emails are
# written to the log instead of being sent (shown as "not sent"). Required in production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Your Brevo SMTP login, e.g. 1a2b3c001@smtp-brevo.com
SMTP_USER=
# Your Brevo SMTP key (xsmtpsib-...)
SMTP_PASS=
# A sender address verified in Brevo
EMAIL_FROM=
EMAIL_FROM_NAME=EduPath Consultancy
# Team addresses told about new registrations (comma separated, optional)
ADMIN_NOTIFY_EMAILS=

# Private uploads (profile photos, requested documents). Relative to the project root; never a public folder.
UPLOAD_DIR=storage/uploads
# Razorpay: online payment of the consultancy service charge (use this project's own keys; test keys start rzp_test_).
# Payments stay switched off until the key id and secret are set. The webhook secret is set in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Swagger UI at /api/docs (default: on in development, off in production).
API_DOCS=

# Frontend server -> backend (used by the Next.js /api proxy)
API_INTERNAL_URL=http://localhost:5100
# Browser-visible (Next.js). Only NEXT_PUBLIC_ values reach the browser: never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api
